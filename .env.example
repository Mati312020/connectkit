# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Database (Supabase PostgreSQL) ───────────────────────────
# Usar la URL con pooler (puerto 6543) para DATABASE_URL
# Usar la URL directa (puerto 5432) para DIRECT_URL (migraciones)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Mercado Pago ─────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.ar/developers/panel
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=tu_webhook_secret_generado_en_panel_mp

# ── ARCA / AFIP (Facturación Fiscal) ────────────────────────
# Requiere alta previa como monotributista o responsable inscripto
# Guía completa en: docs/invoicing.md
ARCA_ENABLED=false
ARCA_ENV=testing          # testing | production
ARCA_CUIT=20-12345678-9
ARCA_PUNTO_VENTA=1
# Certificados digitales en base64 (ver docs/invoicing.md para generarlos)
ARCA_CERT=LS0tLS1CRU...   # Certificado .crt en base64
ARCA_PRIVATE_KEY=LS0t...   # Clave privada .key en base64

# ── Supabase Storage (PDFs de facturas) ─────────────────────
# Crear un bucket "invoices" (público) en Supabase Dashboard → Storage
# Si querés PDFs privados, cambiarlo a privado y usar signed URLs
# SUPABASE_SERVICE_ROLE_KEY (arriba) ya sirve para subir archivos

# ── Email (Resend) ────────────────────────────────────────────
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@tudominio.com
EMAIL_REPLY_TO=soporte@tudominio.com
